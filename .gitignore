*[Aa][Pp][Ii][ -_][Kk][Ee][Yy]*
*[Rr]ecovery*[Cc]ode*
*[Dd]ebug*[Tt]oken*
*[Cc]redential*
*[Ss]ecret*
*.pem
*.key
*.p12
*.pfx
.env
.env.*

