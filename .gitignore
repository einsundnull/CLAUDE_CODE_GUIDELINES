# Sperrliste: dieses Repo ist oeffentlich, bin/push.sh macht "git add -A".
# Schluessel gehoeren nicht in diesen Ordner. Sie liegen in
# C:\Users\pc\Documents\Schluessel-privat
# Die Eintraege fangen sie ab, falls wieder einer hier abgelegt wird.

# Ordner und Dateien, die hier schon einmal lagen
Keys/
Vercel/
API Key*.txt

